# Local development only. Set real credentials outside source control.
# Copy to .env before running Compose; the public values below are only for local use.
DATABASE_URL=postgresql+psycopg://pmknowledge:localdev@localhost:5432/pmknowledge
# Compose defaults; services bind only to the loopback interface.
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432
API_PORT=8000
# Local CPU embeddings are opt-in. Download weights explicitly before enabling.
EMBEDDINGS_ENABLED=false
SEMANTIC_MIN_SCORE=0.6
# Host cache path; Compose uses its own persistent embedding_models volume.
EMBEDDING_CACHE_DIR=.cache/embeddings
# Tests default to localhost:5432/pmknowledge_test. Export TEST_DATABASE_URL in
# your shell to override it; pytest does not load this value from .env.
# TEST_DATABASE_URL=postgresql+psycopg://pmknowledge:localdev@localhost:5432/pmknowledge_test
# Optional host-only UI build path, after running npm run build in apps/web:
# WEB_DIST_DIR=apps/web/dist
